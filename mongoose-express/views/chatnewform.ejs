<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>new chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>Write new chat here...</h2>
    <form method="post" action="/chats">
        <input type="text" name="from" placeholder="who are you" ><br>
        <textarea name="msg" id="msg">  write your msg here</textarea>
        <input type="text" name="to" placeholder="add reciever" >
        <button type="submit">create chat</button>
    </form>
</body>
</html>