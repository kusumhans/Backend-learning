<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show chats</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>show chats</h1>
    <% for(let chat of chats){ %>
    <div class="chat">
        <p>from: <%= chat.from %></p>
    </div>
    <div class="msg">
        <p>msg: <%= chat.msg %></p>
    </div>
    <div class="to">
        <p>recevied to: <%= chat.to %></p>
    </div>
    <hr>
    <% } %>
</body>
</html>


