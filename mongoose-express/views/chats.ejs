<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show chats</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>show chats</h1>
    <% for(let chat of chats){ %>
    <div class="chat">
        <p>from: <%= chat.from %></p>
    </div>
    <div class="msg">
        <p><%= chat.msg %></p>
    
        <div class="chat-actions">
            <form method="get" action="/chats/<%= chat.id %>/edit">
                <button type="submit" class="edit-btn">Edit</button>
            </form>
    
            <form method="post" action="/chats/<%= chat.id %>?_method=DELETE">
                <button type="submit" class="delete-btn">Delete</button>
            </form>
        </div>
    </div>
    <div class="to">
        <p>recevied to: <%= chat.to %></p>
    </div>
    <div class="chat-time">
        <p class="time">
            <%= chat.created_at.toString().split(" ")[4] %>
        </p>
    
        <p class="date">
            <%= chat.created_at.toString().split(" ").splice(0, 4).join(" ") %>
        </p>
    </div>  
    <hr>
    <% } %>
    <form method="get" action="/chats/new">
    <button type="submit" class="new-chat-btn">add new chat</button>
    </form>
    
</body> 
</html>


